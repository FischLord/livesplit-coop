{
  "name": "livesplit-coop-relay",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Workers Logs: errors and request metadata (the code logs no timer data or keys). Visible in the dashboard.
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "QUOTA", "class_name": "Quota" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Quota"] }],
  // Burst protection per client IP and Cloudflare location; the daily total is enforced by the Quota object.
  "ratelimits": [{ "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "vars": {
    // Set to "0" and redeploy to stop new rooms (kill switch); existing rooms keep working.
    "ROOM_CREATION": "1",
    "ROOMS_PER_DAY": "500"
  },
  "env": {
    // Local conformance tests only (wrangler dev --env test): they create more rooms per minute than production allows.
    "test": {
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "Room" },
          { "name": "QUOTA", "class_name": "Quota" }
        ]
      },
      "ratelimits": [{ "name": "CREATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 1000, "period": 60 } }],
      "vars": { "ROOM_CREATION": "1", "ROOMS_PER_DAY": "100000" }
    }
  }
}
